                            "type": "linear",
                            "direction": "vertical",
                            "crossAxisAlignment": "stretch",
                            "spacing": 2,
                            "children": [
                              {
                                "type": "linear",
                                "direction": "horizontal",
                                "crossAxisAlignment": "center",
                                "children": [
                                  {
                                    "type": "container",
                                    "width": 56,
                                    "alignment": "centerStart",
                                    "child": {
                                      "type": "text",
                                      "content": "{{item.no}}",
                                      "textAlign": "start",
                                      "maxLines": 1,
                                      "style": {
                                        "fontSize": 15,
                                        "color": "{{theme.color.primary}}",
                                        "textAlign": "start",
