                                      }
                                    }
                                  },
                                  {
                                    "type": "box",
                                    "width": 8
                                  },
                                  {
                                    "type": "expanded",
                                    "child": {
                                      "type": "text",
                                      "content": "{{item.item}}",
                                      "style": {
                                        "fontSize": 16,
                                        "color": "{{theme.color.onSurface}}"
                                      }
                                    }
                                  },
                                  {
                                    "type": "box",
                                    "width": 8
                                  }
                                ]
                              },
                              {
                                "type": "linear",
                                "direction": "horizontal",
                                "crossAxisAlignment": "center",
                                "children": [
                                  {
                                    "type": "expanded",
                                    "child": {
                                      "type": "wrap",
                                      "spacing": 10,
                                      "runSpacing": 2,
                                      "children": []
