                                  },
                                  {
                                    "type": "wrap",
                                    "spacing": 10,
                                    "runSpacing": 2,
                                    "children": [
                                      {
                                        "type": "container",
                                        "width": 130,
                                        "child": {
                                          "type": "text",
                                          "content": "{{item.place}}",
